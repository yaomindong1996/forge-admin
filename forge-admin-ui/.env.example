# 环境变量配置示例

# 应用标题
VITE_TITLE=Forge Admin

# API基础路径
VITE_API_BASE_URL=/

# 公共路径
VITE_PUBLIC_PATH=/

# 是否使用hash路由
VITE_USE_HASH=false

# 首页路径
VITE_HOME_PATH=/home

# 子系统前端入口地址映射（用于 admin 端单点登录跳转）
# JSON 格式，key 对应 sys_client.clientCode
# 菜单里如果直接配置了完整 URL，会优先使用菜单 URL 中的地址
VITE_SSO_BRIDGE_ROUTE=/report/design
VITE_SSO_TARGET_CLIENT=forge_report
VITE_SSO_TARGET_BASE_URLS={"forge_report":"http://localhost:3021/forge-report"}
VITE_SSO_DEFAULT_REDIRECTS={"forge_report":"/project/items"}

# 兼容旧配置：forge_report 未在上面的映射中配置时，使用这个地址兜底
VITE_REPORT_UI_BASE_URL=http://localhost:3021/forge-report
VITE_REPORT_UI_DEFAULT_REDIRECT=/project/items
VITE_REPORT_UI_HOST_FALLBACK=localhost:3021
VITE_REPORT_UI_PATH_PREFIX=/forge-report

# 客户端配置（新增）
# 客户端AppId
VITE_APP_ID=forge_pc_001
