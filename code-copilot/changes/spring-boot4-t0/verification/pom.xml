<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.mdframe.forge.compatibility</groupId>
    <artifactId>spring-boot4-t0</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Spring Boot 4 T0 isolated probes</name>

    <!-- 不继承生产 POM，避免旧 Boot BOM / 已安装 Forge JAR 造成假阳性。 -->
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <probe.profile>boot4-target</probe.profile>
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <alibaba.version>2.0.0-M1.1</alibaba.version>
        <flowable.version>8.0.0</flowable.version>
        <lombok.version>1.18.34</lombok.version>
        <maven.test.skip>true</maven.test.skip>
    </properties>

    <modules>
        <module>flow-probe</module>
        <module>ai-probe</module>
        <module>mcp-probe</module>
        <module>ai-runtime-probe</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${project.basedir}/target/${probe.profile}</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>17</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables>
                        <probe.profile>${probe.profile}</probe.profile>
                        <probe.boot.version>${spring-boot.version}</probe.boot.version>
                        <probe.ai.version>${spring-ai.version}</probe.ai.version>
                        <probe.flowable.version>${flowable.version}</probe.flowable.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>enable-tests</id>
            <properties><maven.test.skip>false</maven.test.skip></properties>
        </profile>
        <profile>
            <id>boot3-baseline</id>
            <properties>
                <probe.profile>boot3-baseline</probe.profile>
                <spring-boot.version>3.5.13</spring-boot.version>
                <spring-ai.version>1.1.8</spring-ai.version>
                <alibaba.version>1.1.2.3</alibaba.version>
                <flowable.version>7.0.1</flowable.version>
            </properties>
        </profile>
        <profile>
            <id>boot4-target</id>
            <properties><probe.profile>boot4-target</probe.profile></properties>
        </profile>
        <profile>
            <id>boot4-old-ai</id>
            <properties>
                <probe.profile>boot4-old-ai</probe.profile>
                <spring-ai.version>1.1.8</spring-ai.version>
                <alibaba.version>1.1.2.3</alibaba.version>
            </properties>
        </profile>
        <profile>
            <id>boot4-alibaba-upstream</id>
            <properties>
                <probe.profile>boot4-alibaba-upstream</probe.profile>
                <spring-boot.version>4.0.0</spring-boot.version>
                <spring-ai.version>2.0.0-M1</spring-ai.version>
            </properties>
        </profile>
    </profiles>
</project>
