<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mdframe.forge.compatibility</groupId>
        <artifactId>spring-boot4-t0</artifactId>
        <version>0.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>ai-runtime-probe</artifactId>
    <properties>
        <forge.repository.root>${project.basedir}/../../../../..</forge.repository.root>
        <forge.framework.root>${forge.repository.root}/forge-server/forge-framework</forge.framework.root>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-dashscope</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
            <version>3.5.7</version>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>3.5.16</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>real-dashscope-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${forge.framework.root}/forge-plugin-parent/forge-plugin-ai/src/main/java
                                </source>
                                <source>
                                    ${forge.framework.root}/forge-starter-parent/forge-starter-core/src/main/java
                                </source>
                                <source>
                                    ${forge.framework.root}/forge-starter-parent/forge-starter-tenant/src/main/java
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 不编译旧 OpenAI API；原始源码失败证据仍保留在 ai-probe。 -->
                    <includes>
                        <include>com/mdframe/forge/plugin/ai/provider/domain/AiProvider.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/AiProviderAdapter.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/AiProviderAdapterCode.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/AiModelRuntimeOptions.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/AiProviderBaseUrlPolicy.java</include>
                        <include>
                            com/mdframe/forge/plugin/ai/provider/adapter/DashScopeNativeProviderAdapter.java
                        </include>
                        <include>com/mdframe/forge/starter/core/domain/BaseEntity.java</include>
                        <include>com/mdframe/forge/starter/core/exception/BusinessException.java</include>
                        <include>com/mdframe/forge/starter/tenant/core/TenantEntity.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>boot4-alibaba-upstream</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <!-- 上游 M1 仍是旧 OpenAI API；只对照同一套通义测试，不改任何断言。 -->
                            <testExcludes>
                                <testExclude>**/OpenAiSdkCompatibilityTest.java</testExclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
