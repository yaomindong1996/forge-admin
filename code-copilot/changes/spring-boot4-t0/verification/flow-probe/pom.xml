<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mdframe.forge.compatibility</groupId>
        <artifactId>spring-boot4-t0</artifactId>
        <version>0.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>flow-probe</artifactId>
    <properties>
        <forge.repository.root>${project.basedir}/../../../../..</forge.repository.root>
        <forge.framework.root>${forge.repository.root}/forge-server/forge-framework</forge.framework.root>
        <forge.business.root>${forge.repository.root}/forge-server/forge-business</forge.business.root>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>real-purchase-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${forge.business.root}/forge-business-core/src/main/java
                                </source>
                                <source>
                                    ${forge.framework.root}/forge-plugin-parent/forge-plugin-generator/src/main/java
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>
                            com/mdframe/forge/business/core/purchase/support/SamplePurchaseOrderFlowBpmn.java
                        </include>
                        <include>
                            com/mdframe/forge/business/core/purchase/support/SamplePurchaseOrderFlowDefinition.java
                        </include>
                        <include>com/mdframe/forge/business/core/purchase/enums/SamplePurchaseOrderStatus.java</include>
                        <include>
                            com/mdframe/forge/business/core/purchase/dto/SamplePurchaseOrderTaskSaveDTO.java
                        </include>
                        <include>com/mdframe/forge/business/core/purchase/vo/SamplePurchaseOrderVO.java</include>
                        <include>
                            com/mdframe/forge/plugin/generator/dto/businessapp/BusinessTaskFormContextQueryDTO.java
                        </include>
                        <include>
                            com/mdframe/forge/plugin/generator/dto/businessapp/BusinessTaskFormSaveDTO.java
                        </include>
                        <include>
                            com/mdframe/forge/plugin/generator/vo/businessapp/BusinessTaskFormContextVO.java
                        </include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
