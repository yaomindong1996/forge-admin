<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.mdframe.forge.compatibility</groupId>
    <artifactId>spring-boot4-t1-contracts</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <!-- 直接编译真实源码，隔离运行环境；不继承 Forge POM，不使用已安装的 Forge JAR。 -->
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <flowable.version>8.0.0</flowable.version>
        <forge.repository.root>${project.basedir}/../../../..</forge.repository.root>
        <forge.framework.root>${forge.repository.root}/forge-server/forge-framework</forge.framework.root>
        <forge.business.root>${forge.repository.root}/forge-server/forge-business</forge.business.root>
        <maven.test.skip>true</maven.test.skip>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version><type>pom</type><scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId><artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version><type>pom</type><scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.flowable</groupId><artifactId>flowable-spring-boot-starter</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId><artifactId>spring-ai-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId><artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId><artifactId>mybatis-plus-annotation</artifactId><version>3.5.17</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>1.18.34</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.0</version>
                <executions>
                    <execution>
                        <id>real-source</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
                        <configuration><sources>
                            <source>${forge.business.root}/forge-business-core/src/main/java</source>
                            <source>${forge.framework.root}/forge-plugin-parent/forge-plugin-generator/src/main/java</source>
                            <source>${forge.framework.root}/forge-plugin-parent/forge-plugin-ai/src/main/java</source>
                            <source>${forge.framework.root}/forge-starter-parent/forge-starter-core/src/main/java</source>
                            <source>${forge.framework.root}/forge-starter-parent/forge-starter-tenant/src/main/java</source>
                        </sources></configuration>
                    </execution>
                    <execution>
                        <id>existing-tests</id><phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration><sources>
                            <source>${project.basedir}/../../spring-boot4-t0/verification/flow-probe/src/test/java</source>
                            <source>${forge.framework.root}/forge-plugin-parent/forge-plugin-ai/src/test/java</source>
                        </sources></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version>
                <configuration>
                    <release>17</release>
                    <includes>
                        <include>com/mdframe/forge/business/core/purchase/support/SamplePurchaseOrderFlow*.java</include>
                        <include>com/mdframe/forge/business/core/purchase/enums/SamplePurchaseOrderStatus.java</include>
                        <include>com/mdframe/forge/business/core/purchase/dto/SamplePurchaseOrderTaskSaveDTO.java</include>
                        <include>com/mdframe/forge/business/core/purchase/vo/SamplePurchaseOrderVO.java</include>
                        <include>com/mdframe/forge/plugin/generator/dto/businessapp/BusinessTaskForm*DTO.java</include>
                        <include>com/mdframe/forge/plugin/generator/vo/businessapp/BusinessTaskFormContextVO.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/domain/AiProvider.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/AiProviderAdapter.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/AiProviderAdapterCode.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/AiModelRuntimeOptions.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/AiProviderBaseUrlPolicy.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/OpenAi*.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/adapter/DashScopeNativeProviderAdapter.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/dashscope/*.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/support/AiProviderFailureDiagnostics.java</include>
                        <include>com/mdframe/forge/plugin/ai/provider/support/AiProviderRequestException.java</include>
                        <include>com/mdframe/forge/starter/core/domain/BaseEntity.java</include>
                        <include>com/mdframe/forge/starter/core/exception/BusinessException.java</include>
                        <include>com/mdframe/forge/starter/tenant/core/TenantEntity.java</include>
                    </includes>
                    <testIncludes>
                        <testInclude>com/mdframe/forge/compatibility/flow/*.java</testInclude>
                        <testInclude>com/mdframe/forge/plugin/ai/provider/adapter/AiLoopbackFixture.java</testInclude>
                        <testInclude>com/mdframe/forge/plugin/ai/provider/adapter/AiProviderHttpContractTest.java</testInclude>
                        <testInclude>com/mdframe/forge/plugin/ai/provider/adapter/OpenAiCompatibleProviderAdapterTest.java</testInclude>
                        <testInclude>com/mdframe/forge/plugin/ai/provider/adapter/DashScopeNativeProviderAdapterTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables><probe.boot.version>${spring-boot.version}</probe.boot.version></systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile><id>enable-tests</id><properties><maven.test.skip>false</maven.test.skip></properties></profile>
    </profiles>
</project>
