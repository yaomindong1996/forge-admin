<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mdframe.forge.plugin.system.mapper.SysLoginLogMapper">

    <select id="selectLoginLogPage" resultType="com.mdframe.forge.plugin.system.entity.SysLoginLog">
        SELECT id,
               tenant_id,
               user_id,
               username,
               login_type,
               login_status,
               login_ip,
               login_location,
               browser,
               os,
               user_agent,
               login_message,
               login_time,
               client_code
        FROM sys_login_log
        <where>
            <if test="query != null and query.username != null and query.username != ''">
                AND username LIKE CONCAT('%', #{query.username}, '%')
            </if>
            <if test="query != null and query.loginType != null and query.loginType != ''">
                AND login_type = #{query.loginType}
            </if>
            <if test="query != null and query.loginStatus != null">
                AND login_status = #{query.loginStatus}
            </if>
            <if test="query != null and query.loginIp != null and query.loginIp != ''">
                AND login_ip LIKE CONCAT('%', #{query.loginIp}, '%')
            </if>
            <if test="query != null and query.browser != null and query.browser != ''">
                AND browser LIKE CONCAT('%', #{query.browser}, '%')
            </if>
            <if test="query != null and query.os != null and query.os != ''">
                AND os LIKE CONCAT('%', #{query.os}, '%')
            </if>
            <if test="startTime != null and startTime != ''">
                AND login_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND login_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY login_time DESC
    </select>

</mapper>
