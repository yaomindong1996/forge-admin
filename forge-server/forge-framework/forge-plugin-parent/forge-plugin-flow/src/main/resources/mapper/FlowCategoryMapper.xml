<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mdframe.forge.starter.flow.mapper.FlowCategoryMapper">

    <!-- 分类管理页：含停用分类，否则停用后无法在管理页重新启用；租户条件由租户拦截器追加 -->
    <select id="selectManageList" resultType="com.mdframe.forge.starter.flow.entity.FlowCategory">
        SELECT id,
               tenant_id,
               parent_id,
               level,
               ancestors,
               category_code,
               category_name,
               description,
               sort_order,
               status,
               create_time,
               update_time
        FROM sys_flow_category
        ORDER BY sort_order ASC, create_time ASC, id ASC
    </select>
</mapper>
