INSERT INTO sys_dict_type (
  tenant_id, dict_name, dict_type, dict_status, remark, create_by, create_time, update_by, update_time, create_dept
)
SELECT 1, '${dictName}', '${column.dictType}', 1, '${functionName}${dictName}字典', 1, NOW(), 1, NOW(), 1
WHERE NOT EXISTS (
  SELECT 1
  FROM sys_dict_type dict_type
  WHERE dict_type.tenant_id = 1
    AND dict_type.dict_type = '${column.dictType}'
    AND dict_type.del_flag = 0
);

