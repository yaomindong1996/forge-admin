  tenant_id, dict_sort, dict_label, dict_value, dict_type,
  list_class, is_default, dict_status, remark,
  create_by, create_time, update_by, update_time, create_dept
)
SELECT 1, ${sortIndex}, '${dictLabel}', '${dictValue}', '${column.dictType}',
       'default', 'N', 1, '${functionName}${dictName}',
       1, NOW(), 1, NOW(), 1
WHERE NOT EXISTS (
  SELECT 1
  FROM sys_dict_data dict_data
  WHERE dict_data.tenant_id = 1
    AND dict_data.dict_type = '${column.dictType}'
    AND dict_data.dict_value = '${dictValue}'
    AND dict_data.del_flag = 0
);

