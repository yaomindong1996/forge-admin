<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mdframe.forge.plugin.generator.mapper.GenTableColumnMapper">

    <resultMap id="GenTableColumnResultMap" type="com.mdframe.forge.plugin.generator.domain.entity.GenTableColumn">
        <id property="columnId" column="column_id"/>
        <result property="tableId" column="table_id"/>
        <result property="columnName" column="column_name"/>
        <result property="columnComment" column="column_comment"/>
        <result property="columnType" column="column_type"/>
        <result property="javaType" column="java_type"/>
        <result property="javaField" column="java_field"/>
        <result property="isPk" column="is_pk"/>
        <result property="isIncrement" column="is_increment"/>
        <result property="isRequired" column="is_required"/>
        <result property="isInsert" column="is_insert"/>
        <result property="isEdit" column="is_edit"/>
        <result property="isList" column="is_list"/>
        <result property="isQuery" column="is_query"/>
        <result property="queryType" column="query_type"/>
        <result property="htmlType" column="html_type"/>
        <result property="dictType" column="dict_type"/>
        <result property="validateRule" column="validate_rule"/>
        <result property="formulaConfig" column="formula_config"/>
        <result property="aiRecommended" column="ai_recommended"/>
        <result property="sort" column="sort"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="GenTableColumnColumns">
        column_id, table_id, column_name, column_comment, column_type, java_type,
        java_field, is_pk, is_increment, is_required, is_insert, is_edit, is_list,
        is_query, query_type, html_type, dict_type, validate_rule, formula_config,
        ai_recommended, sort, create_time, update_time
    </sql>

    <select id="selectDbTableColumnsByName" resultMap="GenTableColumnResultMap">
        SELECT column_name,
               column_comment,
               column_type,
               CASE WHEN column_key = 'PRI' THEN 1 ELSE 0 END AS is_pk,
               CASE WHEN extra = 'auto_increment' THEN 1 ELSE 0 END AS is_increment,
               CASE WHEN is_nullable = 'NO' AND column_key != 'PRI' THEN 1 ELSE 0 END AS is_required
        FROM information_schema.columns
        WHERE table_schema = (SELECT DATABASE())
          AND table_name = #{tableName}
        ORDER BY ordinal_position
    </select>

    <select id="selectByTableId" resultMap="GenTableColumnResultMap">
        SELECT <include refid="GenTableColumnColumns"/>
        FROM gen_table_column
        WHERE table_id = #{tableId}
        ORDER BY sort ASC
    </select>

    <delete id="deleteByTableId">
        DELETE FROM gen_table_column
        WHERE table_id = #{tableId}
    </delete>

    <delete id="deleteByTableIds">
        DELETE FROM gen_table_column
        WHERE table_id IN
        <foreach collection="tableIds" item="tableId" open="(" separator="," close=")">
            #{tableId}
        </foreach>
    </delete>

    <update id="updateRequiredByTableRef">
        UPDATE gen_table_column c
        INNER JOIN gen_table t ON t.table_id = c.table_id
        SET c.is_required = CASE c.column_name
        <foreach collection="columns" item="column">
            WHEN #{column.columnName} THEN #{column.required}
        </foreach>
            ELSE c.is_required
        END,
        c.update_time = NOW()
        WHERE
        <choose>
            <when test="tableId != null">
                t.table_id = #{tableId}
            </when>
            <otherwise>
                t.table_name = #{tableName}
            </otherwise>
        </choose>
          AND c.column_name IN
        <foreach collection="columns" item="column" open="(" separator="," close=")">
            #{column.columnName}
        </foreach>
    </update>

</mapper>
