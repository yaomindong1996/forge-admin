# ============================================
# Forge Admin Docker 环境变量配置
# ============================================
# 复制此文件为 .env 并修改相应配置
# ============================================

# MySQL 配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=forge_admin
MYSQL_USER=root
MYSQL_PASSWORD=forge123456
MYSQL_CHARSET=utf8mb4

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=forge123456

# 时区
TZ=Asia/Shanghai

# 后端服务端口
ADMIN_PORT=8580
FLOW_PORT=8081

# Flow 服务地址
FLOW_CLIENT_URL=http://forge-flow:8081

# JVM 参数
JAVA_OPTS=-Xms256m -Xmx512m

# 客户端凭据迁移完成且盘点归零后设为 false。
FORGE_AUTH_LEGACY_CLIENT_SECRET_READ_ENABLED=true

# 加密密钥配置
# 新安装保持以下密钥项为空：容器首次启动会自动生成并保存到 crypto_secrets 卷。
# 只有升级已有历史密文时才显式提供原 legacy key 和兼容开关。
FORGE_CRYPTO_BOOTSTRAP_ENABLED=true
FORGE_CRYPTO_BOOTSTRAP_FILE=/var/lib/forge/secrets/crypto.properties
FORGE_CRYPTO_SECRET_KEY=
FORGE_CRYPTO_PERSISTENCE_ENABLED=
FORGE_CRYPTO_PERSISTENCE_WRITE_VERSIONED=
FORGE_CRYPTO_PERSISTENCE_LEGACY_READ_ENABLED=
FORGE_CRYPTO_PERSISTENCE_LEGACY_KEY=
FORGE_CRYPTO_PERSISTENCE_ACTIVE_KEY_ID=
FORGE_CRYPTO_PERSISTENCE_ACTIVE_KEY=

# ============================================
# 应用镜像（可选覆盖；默认已指向阿里云 ACR forgelab 1.0.0）
# 公开镜像架构：linux/arm64（Mac Docker Desktop 构建）
# amd64 服务器需自行用 buildx --platform linux/amd64 重编推送，或暂在 arm64 机器上跑
# ============================================
# FORGE_ADMIN_IMAGE=crpi-4r4vql6tnfnjwl27.cn-guangzhou.personal.cr.aliyuncs.com/forgelab/forge-admin:1.0.0
# FORGE_FLOW_IMAGE=crpi-4r4vql6tnfnjwl27.cn-guangzhou.personal.cr.aliyuncs.com/forgelab/forge-flow:1.0.0
# FORGE_UI_IMAGE=crpi-4r4vql6tnfnjwl27.cn-guangzhou.personal.cr.aliyuncs.com/forgelab/forge-ui:1.0.0

# Nginx 端口
NGINX_PORT=80
