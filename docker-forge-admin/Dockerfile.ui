# ============================================
# Forge Admin UI 前端 Dockerfile
# ============================================
# 构建上下文为项目根目录，docker compose 中 context 设为 ..
# vite / plugin-ui-manifest 依赖仓库根 scripts、POM，不能只 COPY forge-admin-ui
FROM node:23-alpine AS builder
WORKDIR /workspace

# 8G 主机不要用 8192：package.json 的 build 写死了 8G 堆，会把整机打爆。
# 默认 4096；内存紧张可 --build-arg VITE_BUILD_HEAP_MB=3072，充裕可再调到 6144。
ARG VITE_BUILD_HEAP_MB=4096

# 国内镜像；注意是 set 不是 get
RUN npm config set registry https://registry.npmmirror.com \
    && npm install -g pnpm@9

# 整份 scripts（含 forge-shared / forge-plugin / forge-create 等）
COPY scripts ./scripts
COPY CHANGELOG.md ./
# 发行版本与宿主 POM（loadProject / pluginReleaseInfo）
COPY forge-server/pom.xml ./forge-server/pom.xml
COPY forge-server/forge-admin-server/pom.xml ./forge-server/forge-admin-server/pom.xml
COPY forge-server/forge-framework/forge-dependencies/pom.xml \
     ./forge-server/forge-framework/forge-dependencies/pom.xml

# 先装依赖，利用层缓存
COPY forge-admin-ui/package.json forge-admin-ui/pnpm-lock.yaml ./forge-admin-ui/
WORKDIR /workspace/forge-admin-ui
RUN pnpm config set registry https://registry.npmmirror.com \
    && pnpm install --frozen-lockfile

COPY forge-admin-ui/ .
# 不要用 pnpm run build（脚本内写死 8192）；按构建参数限制堆内存
RUN node --max_old_space_size=${VITE_BUILD_HEAP_MB} ./node_modules/vite/bin/vite.js build

FROM nginx:1.25-alpine
COPY --from=builder /workspace/forge-admin-ui/dist /usr/share/nginx/html/forge
COPY docker-forge-admin/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
