# ============================================
# Forge Flow 流程服务 Dockerfile
# ============================================
# 构建上下文为项目根目录，docker compose 中 context 设为 ..
FROM maven:3.9.16-eclipse-temurin-17 AS builder
WORKDIR /build
# 默认使用国内 Maven 镜像（阿里云 public），加速 Docker 本地构建拉依赖
COPY docker-forge-admin/maven-settings.xml /root/.m2/settings.xml
COPY ./forge-server .
RUN mvn -B -ntp clean package -pl forge-flow/forge-flow-server -am -DskipTests -Pprod

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=builder /build/forge-flow/forge-flow-server/target/forge-flow-server.jar app.jar

ENV JAVA_OPTS="-Xms256m -Xmx512m"
ENV SPRING_PROFILES_ACTIVE=prod
ENV MYSQL_HOST=mysql
ENV MYSQL_PORT=3306
ENV MYSQL_DB=forge_admin
ENV MYSQL_USER=root
ENV MYSQL_PASSWORD=forge123456
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379
ENV REDIS_PASSWORD=forge123456

EXPOSE 8081

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} \
  -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE} \
  -jar app.jar"]
