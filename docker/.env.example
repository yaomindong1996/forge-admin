# ============================================
# Forge Admin Docker 环境变量配置
# ============================================
# 复制此文件为 .env 并修改相应配置
# ============================================

# MySQL 配置
MYSQL_PASSWORD=forge123456
MYSQL_DB=forge_admin
MYSQL_PORT=3306

# Redis 配置
REDIS_PASSWORD=forge123456
REDIS_PORT=6379

# 后端服务端口
ADMIN_PORT=8580
FLOW_PORT=8081

# 客户端凭据迁移完成且盘点归零后设为 false。
FORGE_AUTH_LEGACY_CLIENT_SECRET_READ_ENABLED=true

# 加密密钥配置
# 新安装保持以下密钥项为空：容器首次启动会自动生成并保存到 crypto_secrets 卷。
# 只有升级已有历史密文时才显式提供原 legacy key 和兼容开关。
FORGE_CRYPTO_BOOTSTRAP_ENABLED=true
FORGE_CRYPTO_SECRET_KEY=
FORGE_CRYPTO_PERSISTENCE_ENABLED=
FORGE_CRYPTO_PERSISTENCE_WRITE_VERSIONED=
FORGE_CRYPTO_PERSISTENCE_LEGACY_READ_ENABLED=
FORGE_CRYPTO_PERSISTENCE_LEGACY_KEY=
FORGE_CRYPTO_PERSISTENCE_ACTIVE_KEY_ID=
FORGE_CRYPTO_PERSISTENCE_ACTIVE_KEY=

# Nginx 端口
NGINX_PORT=80
