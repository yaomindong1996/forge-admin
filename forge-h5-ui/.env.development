# 开发环境配置
# 端口号（与管理端 3000/3001 错开，对应 forge-admin-ui VITE_H5_BASE_URL）
VITE_HTTP_PORT=3009

# 请求地址前缀
VITE_REQUEST_PREFIX=/dev-api

# 图片host地址
VITE_RESOURCE_HOST=/

# 模板文件下载地址
VITE_TEMPLATE_PATH=/templates

# Forge App 服务代理地址（H5 默认连接 app-server）
VITE_HTTP_PROXY_TARGET=http://127.0.0.1:8583/

# 小程序无 Vite 代理，需填写可同时转发 App/Flow 接口的网关绝对地址。
VITE_MP_API_BASE_URL=

# Flowable 流程服务代理地址（待办、审批处理）
VITE_FLOW_PROXY_TARGET=http://127.0.0.1:8081/

# 客户端配置
VITE_USER_CLIENT=h5
VITE_APP_ID=forge_h5

# 企业微信工作台免登：已改为后端连接配置控制（sys_social_config.sso_workbench_enabled + connection_code），前端无需再配置
